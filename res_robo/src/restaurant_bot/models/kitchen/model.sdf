<?xml version="1.0"?>

<sdf version="1.7">

<model name="kitchen">

<static>true</static>

<link name="kitchen_link">

  <!-- ================= FLOOR ================= -->

  <visual name="floor">

    <pose>0 0 0.025 0 0 0</pose>

    <geometry>

      <box>

        <size>4 4 0.05</size>

      </box>

    </geometry>

    <material>

      <ambient>0.85 0.85 0.85 1</ambient>

      <diffuse>0.85 0.85 0.85 1</diffuse>

    </material>

  </visual>

  <collision name="floor_collision">

    <pose>0 0 0.025 0 0 0</pose>

    <geometry>

      <box>

        <size>4 4 0.05</size>

      </box>

    </geometry>

  </collision>

  <!-- ================= SERVING COUNTER ================= -->

  <visual name="counter">

    <pose>1.2 0 0.45 0 0 0</pose>

    <geometry>

      <box>

        <size>2.0 0.6 0.9</size>

      </box>

    </geometry>

    <material>

      <ambient>0.45 0.45 0.45 1</ambient>

      <diffuse>0.45 0.45 0.45 1</diffuse>

    </material>

  </visual>

  <collision name="counter_collision">

    <pose>1.2 0 0.45 0 0 0</pose>

    <geometry>

      <box>

        <size>2.0 0.6 0.9</size>

      </box>

    </geometry>

  </collision>

  <!-- ================= BACK COUNTER ================= -->

  <visual name="back_counter">

    <pose>-1.3 0 0.45 0 0 0</pose>

    <geometry>

      <box>

        <size>2.3 0.7 0.9</size>

      </box>

    </geometry>

    <material>

      <ambient>0.55 0.55 0.55 1</ambient>

      <diffuse>0.55 0.55 0.55 1</diffuse>

    </material>

  </visual>

  <collision name="back_counter_collision">

    <pose>-1.3 0 0.45 0 0 0</pose>

    <geometry>

      <box>

        <size>2.3 0.7 0.9</size>

      </box>

    </geometry>

  </collision>

  <!-- ================= REFRIGERATOR ================= -->

  <visual name="fridge">

    <pose>-1.7 -1.3 1.0 0 0 0</pose>

    <geometry>

      <box>

        <size>0.8 0.8 2.0</size>

      </box>

    </geometry>

    <material>

      <ambient>0.9 0.9 0.95 1</ambient>

      <diffuse>0.9 0.9 0.95 1</diffuse>

    </material>

  </visual>

  <collision name="fridge_collision">

    <pose>-1.7 -1.3 1.0 0 0 0</pose>

    <geometry>

      <box>

        <size>0.8 0.8 2.0</size>

      </box>

    </geometry>

  </collision>

  <!-- ================= STOVE ================= -->

  <visual name="stove">

    <pose>-0.2 1.3 0.45 0 0 0</pose>

    <geometry>

      <box>

        <size>0.8 0.7 0.9</size>

      </box>

    </geometry>

    <material>

      <ambient>0.2 0.2 0.2 1</ambient>

      <diffuse>0.2 0.2 0.2 1</diffuse>

    </material>

  </visual>

  <collision name="stove_collision">

    <pose>-0.2 1.3 0.45 0 0 0</pose>

    <geometry>

      <box>

        <size>0.8 0.7 0.9</size>

      </box>

    </geometry>

  </collision>

  <!-- ================= SINK ================= -->

  <visual name="sink">

    <pose>-1.7 1.3 0.45 0 0 0</pose>

    <geometry>

      <box>

        <size>0.9 0.7 0.9</size>

      </box>

    </geometry>

    <material>

      <ambient>0.75 0.75 0.75 1</ambient>

      <diffuse>0.75 0.75 0.75 1</diffuse>

    </material>

  </visual>

  <collision name="sink_collision">

    <pose>-1.7 1.3 0.45 0 0 0</pose>

    <geometry>

      <box>

        <size>0.9 0.7 0.9</size>

      </box>

    </geometry>

  </collision>

</link>

</model>

</sdf>
