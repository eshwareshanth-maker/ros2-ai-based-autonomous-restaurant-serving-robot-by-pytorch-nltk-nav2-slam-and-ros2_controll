<?xml version="1.0"?>
<robot name="restaurant_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================= PROPERTIES ================= -->
  <xacro:property name="chassis_length" value="0.5"/>
  <xacro:property name="chassis_width"  value="0.4"/>
  <xacro:property name="chassis_height" value="0.15"/>

  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_separation" value="0.45"/>

  <xacro:property name="caster_radius" value="0.03"/>

  <xacro:property name="tray_length" value="0.45"/>
  <xacro:property name="tray_width" value="0.35"/>
  <xacro:property name="tray_height" value="0.01"/>
  <xacro:property name="tray_gap" value="0.15"/>

  <!-- NEW -->
  <xacro:property name="rod_radius" value="0.01"/>
  <xacro:property name="rod_height" value="${3*tray_gap}"/>

  <xacro:include filename="$(find restaurant_bot)/urdf/restaurant_bot.gazebo.xacro"/>

  <material name="grey">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>

  <material name="dark">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>

  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>

  <!-- ================= BASE ================= -->

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">

    <visual>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <collision>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 ${chassis_height/2}"/>
      <mass value="15.0"/>
      <inertia
        ixx="0.30"
        ixy="0"
        ixz="0"
        iyy="0.40"
        iyz="0"
        izz="0.40"/>
    </inertial>

  </link>

  <!-- ================= DRIVEN WHEELS ================= -->

  <xacro:macro name="wheel" params="prefix reflect_y">

    <link name="${prefix}_wheel_link">

      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="dark"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="1.0"/>
        <inertia
          ixx="0.001"
          ixy="0"
          ixz="0"
          iyy="0.001"
          iyz="0"
          izz="0.001"/>
      </inertial>

    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0 ${reflect_y*wheel_separation/2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.1" friction="0.0"/>
    </joint>

  </xacro:macro>

  <xacro:wheel prefix="left" reflect_y="1"/>
  <xacro:wheel prefix="right" reflect_y="-1"/>

  <!-- ================= CASTERS ================= -->

  <xacro:macro name="caster" params="prefix x_pos">

    <link name="${prefix}_caster_link">

      <visual>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
        <material name="dark"/>
      </visual>

      <collision>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.3"/>
        <inertia
          ixx="0.0001"
          ixy="0"
          ixz="0"
          iyy="0.0001"
          iyz="0"
          izz="0.0001"/>
      </inertial>

    </link>

    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${prefix}_caster_link"/>
      <origin xyz="${x_pos} 0 -${wheel_radius-caster_radius}" rpy="0 0 0"/>
    </joint>

  </xacro:macro>

  <xacro:caster prefix="front" x_pos="0.22"/>
  <xacro:caster prefix="rear" x_pos="-0.22"/>

  <!-- ================= SUPPORT RODS ================= -->

  <xacro:macro name="support_rod" params="name x y">

    <link name="${name}_rod_link">

      <visual>
        <origin xyz="0 0 ${rod_height/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${rod_radius}" length="${rod_height}"/>
        </geometry>
        <material name="grey"/>
      </visual>

      <collision>
        <origin xyz="0 0 ${rod_height/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${rod_radius}" length="${rod_height}"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 ${rod_height/2}"/>
        <mass value="0.2"/>
        <inertia
          ixx="0.0002"
          ixy="0"
          ixz="0"
          iyy="0.0002"
          iyz="0"
          izz="0.0002"/>
      </inertial>

    </link>

    <joint name="${name}_rod_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_rod_link"/>
      <origin xyz="${x} ${y} ${chassis_height}" rpy="0 0 0"/>
    </joint>

  </xacro:macro>

  <xacro:support_rod
      name="front_left"
      x="${chassis_length/2 - 0.04}"
      y="${chassis_width/2 - 0.04}"/>

  <xacro:support_rod
      name="front_right"
      x="${chassis_length/2 - 0.04}"
      y="${-chassis_width/2 + 0.04}"/>

  <xacro:support_rod
      name="rear_left"
      x="${-chassis_length/2 + 0.04}"
      y="${chassis_width/2 - 0.04}"/>

  <xacro:support_rod
      name="rear_right"
      x="${-chassis_width/2 + 0.04}"
      y="${-chassis_width/2 + 0.04}"/>
      
  <!-- ================= TRAYS (x3) ================= -->

  <xacro:macro name="tray" params="index z_height">

    <link name="tray_${index}_link">

      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${tray_length} ${tray_width} ${tray_height}"/>
        </geometry>
        <material name="white"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${tray_length} ${tray_width} ${tray_height}"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.5"/>
        <inertia
            ixx="0.001"
            ixy="0"
            ixz="0"
            iyy="0.001"
            iyz="0"
            izz="0.001"/>
      </inertial>

    </link>

    <joint name="tray_${index}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="tray_${index}_link"/>
      <origin xyz="0 0 ${z_height}" rpy="0 0 0"/>
    </joint>

  </xacro:macro>


  <!-- Tray 1 -->
  <xacro:tray
      index="1"
      z_height="${chassis_height + tray_gap}"/>

  <!-- Tray 2 -->
  <xacro:tray
      index="2"
      z_height="${chassis_height + 2*tray_gap}"/>

  <!-- Tray 3 -->
  <xacro:tray
      index="3"
      z_height="${chassis_height + 3*tray_gap}"/>



  <!-- ================= LIDAR ================= -->

  <link name="lidar_link">

    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.04"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.03" length="0.04"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.1"/>
      <inertia
        ixx="0.0001"
        ixy="0"
        ixz="0"
        iyy="0.0001"
        iyz="0"
        izz="0.0001"/>
    </inertial>

  </link>

  <!-- FIXED TO TOP TRAY -->
  <joint name="lidar_joint" type="fixed">
    <parent link="tray_3_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.15 0 0.03" rpy="0 0 0"/>
  </joint>



  <!-- ================= RGB CAMERA ================= -->

  <link name="camera_link">

    <visual>
      <geometry>
        <box size="0.02 0.05 0.02"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <geometry>
        <box size="0.02 0.05 0.02"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.05"/>
      <inertia
        ixx="0.00005"
        ixy="0"
        ixz="0"
        iyy="0.00005"
        iyz="0"
        izz="0.00005"/>
    </inertial>

  </link>

  <!-- CAMERA MOUNTED ON TOP TRAY -->
  <joint name="camera_joint" type="fixed">
    <parent link="tray_3_link"/>
    <child link="camera_link"/>
    <origin xyz="0.18 0 0.02" rpy="0 0 0"/>
  </joint>



  <!-- ================= DEPTH CAMERA ================= -->

  <link name="depth_camera_link">

    <visual>
      <geometry>
        <box size="0.02 0.08 0.02"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <geometry>
        <box size="0.02 0.08 0.02"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.05"/>
      <inertia
        ixx="0.00005"
        ixy="0"
        ixz="0"
        iyy="0.00005"
        iyz="0"
        izz="0.00005"/>
    </inertial>

  </link>

  <!-- DEPTH CAMERA MOUNTED ON TOP TRAY -->
  <joint name="depth_camera_joint" type="fixed">
    <parent link="tray_3_link"/>
    <child link="depth_camera_link"/>
    <origin xyz="0.18 0 -0.02" rpy="0 0 0"/>
  </joint>
  
  
    <!-- ================= TRAY SUPPORT BRACKETS ================= -->

  <xacro:macro name="tray_bracket" params="name parent x y">

    <link name="${name}_link">

      <visual>
        <origin xyz="0 0 0" rpy="0 1.5708 0"/>
        <geometry>
          <cylinder radius="0.006" length="0.03"/>
        </geometry>
        <material name="grey"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 1.5708 0"/>
        <geometry>
          <cylinder radius="0.006" length="0.03"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.05"/>
        <inertia
          ixx="0.00001"
          ixy="0"
          ixz="0"
          iyy="0.00001"
          iyz="0"
          izz="0.00001"/>
      </inertial>

    </link>

    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
    </joint>

  </xacro:macro>


  <!-- Tray 1 Brackets -->

  <xacro:tray_bracket
      name="tray1_fl"
      parent="tray_1_link"
      x="0.21"
      y="0.16"/>

  <xacro:tray_bracket
      name="tray1_fr"
      parent="tray_1_link"
      x="0.21"
      y="-0.16"/>

  <xacro:tray_bracket
      name="tray1_rl"
      parent="tray_1_link"
      x="-0.21"
      y="0.16"/>

  <xacro:tray_bracket
      name="tray1_rr"
      parent="tray_1_link"
      x="-0.21"
      y="-0.16"/>



  <!-- Tray 2 Brackets -->

  <xacro:tray_bracket
      name="tray2_fl"
      parent="tray_2_link"
      x="0.21"
      y="0.16"/>

  <xacro:tray_bracket
      name="tray2_fr"
      parent="tray_2_link"
      x="0.21"
      y="-0.16"/>

  <xacro:tray_bracket
      name="tray2_rl"
      parent="tray_2_link"
      x="-0.21"
      y="0.16"/>

  <xacro:tray_bracket
      name="tray2_rr"
      parent="tray_2_link"
      x="-0.21"
      y="-0.16"/>



  <!-- Tray 3 Brackets -->

  <xacro:tray_bracket
      name="tray3_fl"
      parent="tray_3_link"
      x="0.21"
      y="0.16"/>

  <xacro:tray_bracket
      name="tray3_fr"
      parent="tray_3_link"
      x="0.21"
      y="-0.16"/>

  <xacro:tray_bracket
      name="tray3_rl"
      parent="tray_3_link"
      x="-0.21"
      y="0.16"/>

  <xacro:tray_bracket
      name="tray3_rr"
      parent="tray_3_link"
      x="-0.21"
      y="-0.16"/>

     <!-- ================= ros2_control ================= -->

  <ros2_control name="GazeboSystem" type="system">

    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <joint name="left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>

    <joint name="right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>

  </ros2_control>

</robot>
